[Unit]
Description=PrimeCloud music API
After=network-online.target

[Service]
User=primecloud
StateDirectory=primecloud
EnvironmentFile=/etc/primecloud.env
ExecStart=/opt/primecloud/venv/bin/python -u /opt/primecloud/app.py
Restart=on-failure
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
